# =============================================================================
# AI-Ticket-Routing — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your local environment:
#
#   cp .env.example .env
#
# The backend reads these via pydantic-settings (backend/core/config.py).
# Variables without a default are REQUIRED.
# =============================================================================

# ---------- Ollama (local LLM inference) ----------

# Base URL of the Ollama API server.
OLLAMA_BASE_URL=http://localhost:11434

# Model tag to pull / use for LLM completions (e.g. phi3:mini, llama3:8b).
OLLAMA_MODEL=phi3:mini

# ---------- ArangoDB (knowledge graph) ----------

# HTTP endpoint for the ArangoDB server.
ARANGO_URL=http://localhost:8529

# Name of the database that stores the ticket knowledge graph.
ARANGO_DB=ticket_agent

# Database user. "root" is fine for local dev; use a scoped user in production.
ARANGO_USER=root

# Database password. REQUIRED — set a real password; leave blank only for
# a local dev instance with authentication disabled.
ARANGO_PASSWORD=

# ---------- Redis (caching / pub-sub) ----------

# Redis connection URL (redis:// or rediss:// for TLS).
REDIS_URL=redis://localhost:6379

# ---------- Embeddings ----------

# Sentence-transformer model name used to embed ticket text.
# Must match the model used when the vector index was built.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------- Routing behaviour ----------

# Minimum cosine-similarity score (0.0–1.0) for a routing suggestion
# to be considered confident. Below this threshold the ticket is escalated
# for manual triage.
CONFIDENCE_THRESHOLD=0.70

# ---------- Logging ----------

# Python log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
